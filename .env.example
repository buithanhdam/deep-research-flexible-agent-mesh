# ============================================
# REQUIRED
# ============================================
# ==== LLM Provider Selection ====
# Provider nào được dùng làm LLM chính: openrouter | chatgpt | gemini | custom
# Client fail / key thiếu → tự fallback về Gemini (cần GEMINI_API_KEY)
LLM_PROVIDER=gemini
# Override model (optional — để trống dùng model mặc định của provider)
LLM_MODEL=

# ==== Provider Keys (điền key cho provider bạn chọn + fallback) ====
# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.1

# ChatGPT / OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (fallback LLM + Search Grounding)
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Custom OpenAI-compatible endpoint (optional — vLLM, Ollama, LiteLLM, private API)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# ==== Search ====
TAVILY_API_KEY=tvly-xxx
# Exa AI — neural search (optional, fallback thứ 2 sau Tavily)
EXA_API_KEY=
MAX_RETRIES=3
TIMEOUT_SECONDS=120
AGENT_LOOP_MAX_ROUNDS=5
# ==== Logging ====
LOG_LEVEL=INFO
APP_ENV=dev 

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=multi_agent_db
POSTGRES_SCHEMA=agent_mesh  # Schema riêng, tránh conflict với app khác cùng DB

# ============================================
# OPTIONAL (but recommended)
# ============================================

# GitHub API (optional — tăng rate limit từ 60 → 5000 req/h)
GITHUB_TOKEN=

# Google Drive
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_CREDENTIALS_JSON=credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_folder_id

# Memory
CACHE_DEFAULT_TTL_HOURS=24
CHAT_HISTORY_MAX_MESSAGES=10
AUTO_CLEANUP_ENABLED=true
CHAT_HISTORY_RETENTION_DAYS=30