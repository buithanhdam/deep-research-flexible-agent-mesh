# ==== LLM (bắt buộc) ====
# Lấy tại https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ==== Logging ====
LOG_LEVEL=INFO
APP_ENV=prod

# ==== Database (tùy chọn — để trống nếu chưa cần persist memory) ====

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

MAX_RETRIES=3
TIMEOUT_SECONDS=120

LARK_APP_ID=
LARK_APP_SECRET=

#Memory
CACHE_DEFAULT_TTL_HOURS=24
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_HISTORY_RETENTION_DAYS=30
AUTO_CLEANUP_ENABLED=true