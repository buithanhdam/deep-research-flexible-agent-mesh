# ============================================
# REQUIRED
# ============================================
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=z-ai/glm-5.1
TAVILY_API_KEY=tvly-xxx
MAX_RETRIES=3
TIMEOUT_SECONDS=120
AGENT_LOOP_MAX_ROUNDS=5
# ==== Logging ====
LOG_LEVEL=INFO
APP_ENV=dev

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=multi_agent_db

# ============================================
# OPTIONAL (but recommended)
# ============================================

# Lark
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
LARK_ERROR_CHAT_ID=oc_xxx  # For error notifications
# Human-in-the-loop: tắt (false) mặc định để tránh duplicate với UI chat.
# Bật true khi chạy headless (n8n/cron) và cần nhận kết quả qua Lark.
LARK_NOTIFICATION_ENABLED=false

# GitHub API (optional — tăng rate limit từ 60 → 5000 req/h)
GITHUB_TOKEN=ghp_xxx

# Google Drive
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_CREDENTIALS_JSON=credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_folder_id

# Memory
CACHE_DEFAULT_TTL_HOURS=24
CHAT_HISTORY_MAX_MESSAGES=10
AUTO_CLEANUP_ENABLED=true
CHAT_HISTORY_RETENTION_DAYS=30